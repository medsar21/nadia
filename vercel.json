{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!.*\\.(jpg|jpeg|png|gif|svg|webp|JPG|JPEG|PNG|css|js|ico|woff|woff2|ttf|eot)).*)",
      "destination": "/index.html"
    }
  ]
}





